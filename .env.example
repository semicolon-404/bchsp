APP_NAME="โรงพยาบาลบัวเชด"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bchsp_site
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Whether everyone who uses the panel must set up two-step sign-in. Leave on outside your own machine.
STAFF_TWO_STEP=true

# The nightly backup (App\Support\Backups). On XAMPP for Windows mysqldump is not on the PATH: give its full path.
BACKUP_MYSQLDUMP=mysqldump
BACKUP_KEEP_DAYS=14
# A second folder for the copies, off this disk (another drive, a network share, a synced folder). Leave blank for none.
BACKUP_COPY_TO=

# Shared hosting with no terminal (docs/DEPLOY.th.md): a long random key opens /install?key=... once;
# remove it when the site is set up. SCHEDULE_ON_VISITS=true does the nightly backup after a visitor's page,
# for a server with no scheduler.
INSTALL_KEY=
SCHEDULE_ON_VISITS=false
